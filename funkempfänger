esphome:
  name: tdisplay_ble_counter
  friendly_name: TDisplay BLE Counter

esp32:
  board: esp32dev
  framework:
    type: arduino

logger:

api:

ota:
  platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: "TDisplay BLE Counter Fallback"
    password: "changeme123"

captive_portal:

preferences:
  flash_write_interval: 10min

globals:
  - id: allowed_prefixes
    type: 'std::vector<std::string>'
    restore_value: no
    initial_value: '{"00:25:DF","00:58:28","00:C0:D4"}'

  - id: current_window_seen
    type: 'std::vector<std::string>'
    restore_value: no

  - id: all_seen_addresses
    type: 'std::vector<std::string>'
    restore_value: no

  - id: all_seen_counts
    type: 'std::vector<int>'
    restore_value: no

  - id: total_devices
    type: int
    restore_value: no
    initial_value: '0'

  - id: devices_seen_once
    type: int
    restore_value: no
    initial_value: '0'

  - id: devices_seen_12plus
    type: int
    restore_value: no
    initial_value: '0'

  - id: devices_seen_30plus
    type: int
    restore_value: no
    initial_value: '0'

  - id: devices_seen_other
    type: int
    restore_value: no
    initial_value: '0'

color:
  - id: c_black
    red: 0%
    green: 0%
    blue: 0%
  - id: c_white
    red: 100%
    green: 100%
    blue: 100%
  - id: c_green
    red: 0%
    green: 100%
    blue: 0%
  - id: c_red
    red: 100%
    green: 0%
    blue: 0%
  - id: c_yellow
    red: 100%
    green: 100%
    blue: 0%
  - id: c_cyan
    red: 0%
    green: 80%
    blue: 100%

font:
  - file:
      type: gfonts
      family: Roboto
      weight: 700
    id: font_title
    size: 20

  - file:
      type: gfonts
      family: Roboto Mono
      weight: 700
    id: font_big
    size: 30

  - file:
      type: gfonts
      family: Roboto Mono
      weight: 400
    id: font_med
    size: 18

  - file:
      type: gfonts
      family: Roboto Mono
      weight: 400
    id: font_small
    size: 14

output:
  - platform: ledc
    pin: GPIO4
    id: backlight_pwm

light:
  - platform: monochromatic
    id: backlight
    name: "TDisplay Backlight"
    output: backlight_pwm
    restore_mode: RESTORE_AND_ON

spi:
  clk_pin: GPIO18
  mosi_pin: GPIO19

display:
  - platform: st7789v
    id: tft
    model: TTGO TDisplay 135x240
    cs_pin: GPIO5
    dc_pin: GPIO16
    reset_pin: GPIO23
    backlight_pin: no
    rotation: 270
    update_interval: 1s
    lambda: |-
      it.fill(id(c_black));

      it.printf(120, 4, id(font_title), id(c_yellow), TextAlign::TOP_CENTER, "BLE Device Presence");

      it.printf(10, 32, id(font_med), id(c_white), TextAlign::TOP_LEFT, "Total matched:");
      it.printf(230, 32, id(font_med), id(c_green), TextAlign::TOP_RIGHT, "%d", id(total_devices));

      it.printf(10, 62, id(font_small), id(c_white), TextAlign::TOP_LEFT, "Seen 1 scan:");
      it.printf(230, 62, id(font_small), id(c_cyan), TextAlign::TOP_RIGHT, "%d", id(devices_seen_once));

      it.printf(10, 84, id(font_small), id(c_white), TextAlign::TOP_LEFT, "Seen 2-11:");
      it.printf(230, 84, id(font_small), id(c_cyan), TextAlign::TOP_RIGHT, "%d", id(devices_seen_other));

      it.printf(10, 106, id(font_small), id(c_white), TextAlign::TOP_LEFT, "Seen 12+ scans:");
      it.printf(230, 106, id(font_small), id(c_cyan), TextAlign::TOP_RIGHT, "%d", id(devices_seen_12plus));

      it.printf(10, 128, id(font_small), id(c_white), TextAlign::TOP_LEFT, "Seen 30+ scans:");
      it.printf(230, 128, id(font_small), id(c_cyan), TextAlign::TOP_RIGHT, "%d", id(devices_seen_30plus));

      it.printf(120, 168, id(font_small), id(c_white), TextAlign::TOP_CENTER, "Window: 30 seconds");
      it.printf(120, 188, id(font_small), id(c_white), TextAlign::TOP_CENTER, "Prefixes: 3 tracked");

esp32_ble_tracker:
  scan_parameters:
    interval: 320ms
    window: 300ms
    active: false

  on_ble_advertise:
    - then:
        - lambda: |-
            std::string mac = x.address_str();

            bool prefix_match = false;
            for (auto &prefix : id(allowed_prefixes)) {
              if (mac.rfind(prefix, 0) == 0) {
                prefix_match = true;
                break;
              }
            }

            if (!prefix_match) {
              return;
            }

            bool already_seen_this_window = false;
            for (auto &existing : id(current_window_seen)) {
              if (existing == mac) {
                already_seen_this_window = true;
                break;
              }
            }

            if (!already_seen_this_window) {
              id(current_window_seen).push_back(mac);
              ESP_LOGI("ble_scan", "Matched this window: %s", mac.c_str());
            }

interval:
  - interval: 30s
    then:
      - lambda: |-
          for (auto &mac : id(current_window_seen)) {
            int idx = -1;
            for (size_t i = 0; i < id(all_seen_addresses).size(); i++) {
              if (id(all_seen_addresses)[i] == mac) {
                idx = i;
                break;
              }
            }

            if (idx >= 0) {
              id(all_seen_counts)[idx] += 1;
            } else {
              id(all_seen_addresses).push_back(mac);
              id(all_seen_counts).push_back(1);
            }
          }

          id(current_window_seen).clear();

          id(total_devices) = id(all_seen_addresses).size();
          id(devices_seen_once) = 0;
          id(devices_seen_12plus) = 0;
          id(devices_seen_30plus) = 0;
          id(devices_seen_other) = 0;

          for (size_t i = 0; i < id(all_seen_counts).size(); i++) {
            int c = id(all_seen_counts)[i];

            if (c == 1) {
              id(devices_seen_once) += 1;
            } else if (c >= 30) {
              id(devices_seen_30plus) += 1;
            } else if (c >= 12) {
              id(devices_seen_12plus) += 1;
            } else {
              id(devices_seen_other) += 1;
            }
          }

          ESP_LOGI(
            "ble_scan",
            "Totals: total=%d once=%d other=%d 12plus=%d 30plus=%d",
            id(total_devices),
            id(devices_seen_once),
            id(devices_seen_other),
            id(devices_seen_12plus),
            id(devices_seen_30plus)
          );

binary_sensor:
  - platform: gpio
    pin:
      number: GPIO0
      inverted: true
      mode:
        input: true
        pullup: true
    name: "Button Left"
    on_press:
      - light.dim_relative:
          id: backlight
          relative_brightness: -10%
          transition_length: 200ms

  - platform: gpio
    pin:
      number: GPIO35
      inverted: true
      mode:
        input: true
    name: "Button Right"
    on_press:
      - light.dim_relative:
          id: backlight
          relative_brightness: 10%
          transition_length: 200ms
