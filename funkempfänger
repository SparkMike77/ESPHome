#v0.1

esphome:
  name: tdisplay_ble_counter
  friendly_name: TDisplay BLE Counter

esp32:
  board: esp32dev
  framework:
    type: arduino

logger:

api:

ota:
  platform: esphome

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  ap:
    ssid: "TDisplay BLE Counter Fallback"
    password: "changeme123"

captive_portal:

# Optional but helpful on many T-Displays with larger flash
preferences:
  flash_write_interval: 10min

globals:
  - id: target_count
    type: int
    restore_value: no
    initial_value: '0'

  - id: seen_macs
    type: 'std::vector<std::string>'
    restore_value: no

color:
  - id: c_black
    red: 0%
    green: 0%
    blue: 0%
  - id: c_white
    red: 100%
    green: 100%
    blue: 100%
  - id: c_green
    red: 0%
    green: 100%
    blue: 0%
  - id: c_red
    red: 100%
    green: 0%
    blue: 0%
  - id: c_yellow
    red: 100%
    green: 100%
    blue: 0%

font:
  - file:
      type: gfonts
      family: Roboto
      weight: 700
    id: font_big
    size: 36

  - file:
      type: gfonts
      family: Roboto
      weight: 400
    id: font_med
    size: 20

  - file:
      type: gfonts
      family: Roboto Mono
      weight: 400
    id: font_small
    size: 14

output:
  - platform: ledc
    pin: GPIO4
    id: backlight_pwm

light:
  - platform: monochromatic
    id: backlight
    name: "TDisplay Backlight"
    output: backlight_pwm
    restore_mode: RESTORE_AND_ON

spi:
  clk_pin: GPIO18
  mosi_pin: GPIO19

display:
  - platform: st7789v
    id: tft
    model: TTGO TDisplay 135x240
    cs_pin: GPIO5
    dc_pin: GPIO16
    reset_pin: GPIO23
    backlight_pin: no
    rotation: 270
    update_interval: 1s
    lambda: |-
      it.fill(id(c_black));

      it.printf(120, 8, id(font_med), id(c_yellow), TextAlign::TOP_CENTER, "BLE Prefix Scan");
      it.printf(120, 42, id(font_small), id(c_white), TextAlign::TOP_CENTER, "Target prefix: 00:25:DF");

      it.printf(120, 80, id(font_big), id(c_green), TextAlign::TOP_CENTER, "%d", id(target_count));
      it.printf(120, 126, id(font_med), id(c_white), TextAlign::TOP_CENTER, "devices seen");

      if (id(target_count) == 0) {
        it.printf(120, 168, id(font_small), id(c_red), TextAlign::TOP_CENTER, "No matching BLE devices");
      } else {
        it.printf(120, 168, id(font_small), id(c_green), TextAlign::TOP_CENTER, "Matching devices detected");
      }

esp32_ble_tracker:
  scan_parameters:
    interval: 320ms
    window: 300ms
    active: false

  on_ble_advertise:
    - then:
        - lambda: |-
            std::string mac = x.address_str();

            // Match the manufacturer/OUI prefix here.
            // MAC prefixes are byte-based, so 00:25:DF is the valid 3-byte prefix.
            if (mac.rfind("00:25:DF", 0) == 0) {
              bool already_seen = false;
              for (auto &existing : id(seen_macs)) {
                if (existing == mac) {
                  already_seen = true;
                  break;
                }
              }

              if (!already_seen) {
                id(seen_macs).push_back(mac);
                id(target_count) = id(seen_macs).size();
                ESP_LOGI("ble_scan", "Matched device: %s (count=%d)", mac.c_str(), id(target_count));
              }
            }

interval:
  - interval: 10s
    then:
      - lambda: |-
          id(seen_macs).clear();
          id(target_count) = 0;

binary_sensor:
  - platform: gpio
    pin:
      number: GPIO0
      inverted: true
      mode:
        input: true
        pullup: true
    name: "Button Left"
    on_press:
      - light.dim_relative:
          id: backlight
          relative_brightness: -10%
          transition_length: 200ms

  - platform: gpio
    pin:
      number: GPIO35
      inverted: true
      mode:
        input: true
    name: "Button Right"
    on_press:
      - light.dim_relative:
          id: backlight
          relative_brightness: 10%
          transition_length: 200ms
